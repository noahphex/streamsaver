# Optional session signing key. Blank generates config/.secret_key automatically.
STREAMSAVER_SECRET_KEY=
# Optional unlock passphrase. Set after setup for unattended scheduler runs.
STREAMSAVER_PASSPHRASE=
# Daily scheduler time in TZ (Docker Compose passes this to --run-at).
STREAMSAVER_SCHEDULER_RUN_AT=02:00
# Container timezone and scheduler clock.
TZ=UTC
# Published Docker port; also the local web server port.
STREAMSAVER_PORT=8092
# Container image tag.
STREAMSAVER_VERSION=latest
# Local web server bind address; Docker uses Gunicorn's fixed internal bind.
STREAMSAVER_HOST=0.0.0.0
